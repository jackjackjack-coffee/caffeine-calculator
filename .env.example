# ---------------------------------------------------------------------------
# Caffeine Calculator — environment variables
# ---------------------------------------------------------------------------
#
# The mobile app itself needs NO secrets. It only needs the public URL of your
# deployed Cloudflare Worker. Set this in app.json -> expo.extra.analyzeApiUrl
# (or override at runtime). Example:
#
#   https://caffeine-analyze.<your-subdomain>.workers.dev/analyze
#
# ---------------------------------------------------------------------------
# The following secret lives ONLY in the Cloudflare Worker, never in the app.
# Configure it with:  cd worker && npx wrangler secret put GEMINI_API_KEY
# For local `wrangler dev`, put it in worker/.dev.vars instead.
# ---------------------------------------------------------------------------

# Google Gemini API key (worker-side only). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: which provider/model the worker uses (defaults to gemini).
# VISION_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.0-flash
